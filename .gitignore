# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# VS Code: keep shared launch/settings, ignore local workspace state
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# =============================================================================
# Flutter / Dart / Pub
# =============================================================================
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
.pub/
.pub-cache/
**/doc/api/
**/ios/Flutter/.last_build_id
.widget_preview/

# Build outputs
/build/
/coverage/
app.*.symbols
app.*.map.json
migrate_working_dir/

# Keep these tracked (intentional):
# - pubspec.lock        application lockfile, reproducible builds
# - .metadata           Flutter project metadata
# - assets/db/*.db.gz   prebuilt exercise database required at runtime
# - web/sqlite3.wasm    Drift web runtime
# - web/drift_worker.js Drift web worker
# - docs/*.png          README screenshots / documentation

# =============================================================================
# Android
# =============================================================================
/android/.gradle/
/android/.kotlin/
/android/.cxx/
/android/.externalNativeBuild/
/android/**/build/
/android/captures/
/android/local.properties
/android/key.properties
/android/app/debug/
/android/app/profile/
/android/app/release/
/android/app/google-services.json
/android/app/src/main/res/values/secrets.xml
/android/app/upload-keystore.jks
**/*.jks
**/*.keystore

# Generated by the Flutter tool / Gradle
/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
/android/app/src/main/jniLibs/
/android/gradle/wrapper/gradle-wrapper.jar
/android/gradlew
/android/gradlew.bat

